<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" /> <!-- Needed to post notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <!-- Camera and audio for live photo/video capture -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Play Billing permission (also provided by billing-ktx library manifest) -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Foreground service for background uploads via WorkManager -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Remove screen-capture permission inherited from LiveKit -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />

    <application
        android:name=".GiftersClubApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.GiftersClub"
        tools:targetApi="31">
        <activity
            android:name=".CreateOrGoLiveActivity"
            android:exported="false" />
        <activity
            android:name=".gifts.CreatePostActivity"
            android:exported="false"
            android:theme="@style/Theme.GiftersClub" />
        <activity
            android:name=".gifts.FullscreenPostPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.GiftersClub" />
        <!-- Screen displayed when there is no network connectivity -->
        <activity
            android:name=".NoNetworkActivity"
            android:exported="false" />
        <activity
            android:name=".AuthActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="login-callback"
                    android:scheme="gifterclub" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!-- Deep link for wishlists: https://gifters.club/wishlist/{id} -->
            <!-- App Links verification for https://gifters.club/wishlist -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="gifters.club"
                    android:pathPrefix="/wishlist"
                    android:scheme="http" />
                <data
                    android:host="gifters.club"
                    android:pathPrefix="/wishlist"
                    android:scheme="https" />
            </intent-filter>
            <!-- Custom URI scheme for wishlist (no App Links verification) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="wishlist"
                    android:scheme="giftersclub" />
            </intent-filter>

            <!-- App Links verification for user profiles: https://gifters.club/u/{username} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="gifters.club"
                    android:pathPrefix="/u"
                    android:scheme="http" />
                <data
                    android:host="gifters.club"
                    android:pathPrefix="/u"
                    android:scheme="https" />
            </intent-filter>
            <!-- Custom URI scheme for user profiles (no App Links verification) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="u"
                    android:scheme="giftersclub" />
            </intent-filter>

            <!-- App Links verification for user profiles: https://gifters.club/g/{username} -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="gifters.club"
                    android:pathPrefix="/g"
                    android:scheme="http" />
                <data
                    android:host="gifters.club"
                    android:pathPrefix="/g"
                    android:scheme="https" />
            </intent-filter>
            <!-- Custom URI scheme for user profiles (no App Links verification) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="g"
                    android:scheme="giftersclub" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PostsActivity"
            android:exported="true">

            <!-- App Links verification for https://gifters.club/post -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="gifters.club"
                    android:pathPrefix="/post"
                    android:scheme="http" />
                <data
                    android:host="gifters.club"
                    android:pathPrefix="/post"
                    android:scheme="https" />
            </intent-filter>
            <!-- Custom URI scheme for posts (no App Links verification) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="post"
                    android:scheme="giftersclub" />
            </intent-filter>
        </activity>
        <activity android:name=".payments.PaymentWebViewActivity" /> <!-- uCrop activity for avatar cropping -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".chat.FullscreenMediaActivity"
            android:exported="false"
            android:theme="@style/Theme.GiftersClub" />

        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Declare WorkManager's foreground service with dataSync type for API 34+ -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge"
            tools:replace="android:foregroundServiceType" />

        <activity android:name=".live.LiveStreamActivity" />

        <!-- Rollbar access token via manifest placeholder for Rollbar.init(this) support -->
        <meta-data
            android:name="com.rollbar.android.ACCESS_TOKEN"
            android:value="${ROLLBAR_ACCESS_TOKEN}" />
    </application>

</manifest>
