<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_top"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPurchaseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/purchase_access"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <TextView
        android:id="@+id/tvPurchaseMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="7dp">

        <Button
            android:id="@+id/btnPurchaseConfirm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sky_blue_gradient"
            android:textColor="@color/white"
            android:text="@string/buy" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="7dp">
        <Button
            android:id="@+id/btnPurchaseCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_red_orange_gradient"
            android:textColor="@color/white"
            android:text="@string/cancel" />
    </androidx.cardview.widget.CardView>

</LinearLayout>