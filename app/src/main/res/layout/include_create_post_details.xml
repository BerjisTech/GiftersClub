<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:id="@+id/previewPane"
        android:layout_width="126dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutDetailsPostButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <!-- Post preview (small tall rectangle to the side) -->
        <ImageView
            android:id="@+id/ivPostPreview"
            android:layout_width="126dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/preview"
            android:scaleType="centerInside" />

        <!-- Video preview for details stage (visible only for videos) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/pvPostPreview"
            android:layout_width="126dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            app:show_buffering="when_playing"
            app:surface_type="texture_view"
            app:use_controller="true" />

    </LinearLayout>


    <!-- Top spacer since crop/scale moved to Edit -->
    <View
        android:id="@+id/layoutDetailsTopSpacer"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="top"
        android:hint="@string/whats_on_your_mind"
        android:inputType="textMultiLine"
        android:padding="8dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/layoutDetailsPostButtons"
        app:layout_constraintEnd_toStartOf="@id/previewPane"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDetailsTopSpacer" />

    <LinearLayout
        android:id="@+id/layoutDetailsPostButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layoutDetailsDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnEditMediaCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="7dp">

            <Button
                android:id="@+id/btnEditMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rose_amber_gradient"
                android:text="@string/edit_media"
                android:textColor="@color/white" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:cardCornerRadius="7dp">

            <Button
                android:id="@+id/btnPost"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_green_emerald_gradient"
                android:text="@string/post"
                android:textColor="@color/white" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <View
        android:id="@+id/layoutDetailsDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDetailsTopSpacer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDetailsDivider">

        <RadioGroup
            android:id="@+id/rgAccessType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/free"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/rbSubscriberOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/subscriber_only"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/rbPaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/paid"
                android:textColor="@color/white" />
        </RadioGroup>

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/price_tokens"
            android:inputType="number"
            android:textColor="@color/white"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutPostPlanPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select required plan"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/actvPostPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Choose a plan"
                android:inputType="text"
                android:paddingVertical="8dp"
                android:textColor="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPostNoPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPostNoPlansMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You haven't created any subscription plans yet. Create at least one to use Subscriber Only."
                android:textColor="@color/white" />

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="8dp">

                <Button
                    android:id="@+id/btnOpenSubscriptionSettingsFromPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sky_blue_gradient"
                    android:paddingHorizontal="8dp"
                    android:text="Create a Subscription Plan"
                    android:textColor="@color/white" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
