<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/flLiveStream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/liveTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/streamerDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="center"
            android:padding="4dp"
            android:background="@color/cardview_dark_background">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivStreamerImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/dragon"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"/>

            <TextView
                android:id="@+id/tvStreamerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/streamer_name"
                android:textColor="@android:color/white"
                app:layout_constraintStart_toEndOf="@id/ivStreamerImage"
                app:layout_constraintTop_toTopOf="@id/ivStreamerImage"
                app:layout_constraintBottom_toBottomOf="@id/ivStreamerImage" />
        </LinearLayout>



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFollowStreamer"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/follow"
            android:textAllCaps="false"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/streamerDetails"
            app:layout_constraintTop_toTopOf="@id/streamerDetails"
            app:layout_constraintBottom_toBottomOf="@id/streamerDetails" />

        <TextView
            android:id="@+id/tvViewerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="0"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toStartOf="@id/btnCloseLive"
            app:layout_constraintTop_toTopOf="@id/streamerDetails"
            app:layout_constraintBottom_toBottomOf="@id/streamerDetails" />

        <ImageButton
            android:id="@+id/btnCloseLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/streamerDetails"
            app:layout_constraintBottom_toBottomOf="@id/streamerDetails" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/liveBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#80000000"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etLiveComment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/write_a_comment"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textColorHint="@android:color/darker_gray" />

        <ImageView
            android:id="@+id/btnRoseGift"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/rose"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:layout_marginStart="8dp" />

        <ImageView
            android:id="@+id/btnOpenGifts"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/gift"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/flGiftsBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="0dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.5">

        <include layout="@layout/fragment_live_gifts_bottom_sheet" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>