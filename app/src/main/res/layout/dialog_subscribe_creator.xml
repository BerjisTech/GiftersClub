<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_rounded_top">

    <TextView
        android:id="@+id/tvSubscribeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subscribe_to_creator"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <EditText
        android:id="@+id/etDurationType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/subscription_type_hint"
        android:inputType="text"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etSubscriptionTokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/price_tokens"
        android:inputType="number"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSubscribeConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subscribe"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnSubscribeCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:layout_marginTop="8dp" />

</LinearLayout>