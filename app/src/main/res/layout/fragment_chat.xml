<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- Conversation list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversations"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp" />

    <!-- Chat pane: appears once a conversation is selected -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatPane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">


        <TextView
            android:id="@+id/tvPartnerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="@id/chatPane"
            app:layout_constraintStart_toStartOf="@id/chatPane"
            app:layout_constraintEnd_toEndOf="@id/chatPane" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvPartnerName"
            app:layout_constraintStart_toStartOf="@id/chatPane"
            app:layout_constraintEnd_toEndOf="@id/chatPane"
            app:layout_constraintBottom_toTopOf="@id/chatFormCard" />

        <androidx.cardview.widget.CardView
            android:id="@+id/attachmentPreviewContainerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_half_transparent_white"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toTopOf="@+id/chatFormCard"
            app:layout_constraintEnd_toEndOf="@id/chatPane"
            app:layout_constraintStart_toStartOf="@id/chatPane">

            <FrameLayout
                android:id="@+id/attachmentPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivAttachmentPreview"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop" />

                <ProgressBar
                    android:id="@+id/pbAttachmentUpload"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnCancelAttachment"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/cancel"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/chatFormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_half_transparent_white"
            app:cardCornerRadius="30dp"
            app:layout_constraintBottom_toBottomOf="@id/chatPane"
            app:layout_constraintEnd_toEndOf="@id/chatPane"
            app:layout_constraintStart_toStartOf="@id/chatPane">

            <LinearLayout
                android:id="@+id/chatForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="300dp">

                    <ImageButton
                        android:id="@+id/btnAttach"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_orange_stone_gradient"
                        android:contentDescription="@string/attach"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </androidx.cardview.widget.CardView>

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="7dp"
                    android:layout_weight="1"
                    android:autofillHints="Type something"
                    android:background="@android:color/transparent"
                    android:hint="@string/type_a_message" />


                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="300dp">

                    <ImageButton
                        android:id="@+id/btnSend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_sky_blue_gradient"
                        android:contentDescription="@string/send"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_send" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>