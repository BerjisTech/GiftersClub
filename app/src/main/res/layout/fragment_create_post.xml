<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:csb="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createPostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/flStepContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Text post editor screen (hidden by default) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTextEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Toolbar with Cancel and Done -->
            <LinearLayout
                android:id="@+id/toolbarTextEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/btnCancelTextPost"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="@string/_cancel" />

                <TextView
                    android:id="@+id/tvTextEditorTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/whats_on_your_mind"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnDoneTextPost"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="@string/_ok" />
            </LinearLayout>

            <!-- Tabs for text styling tools -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabTextTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tabGravity="fill"
                app:tabMode="fixed"
                app:tabTextColor="@color/white" />

            <!-- Styling controls (only one group visible at a time) -->
            <LinearLayout
                android:id="@+id/llTextControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                app:layout_constraintBottom_toTopOf="@id/tabTextTools"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <HorizontalScrollView
                    android:id="@+id/hsvTextStyles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llTextStyles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvFontSizes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llFontSizes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvColorPickers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llColorPickers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvBgImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llBgImages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvFonts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llFonts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Editable canvas (rendered to bitmap) -->

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="60dp"
                app:cardCornerRadius="50dp"
                app:layout_constraintBottom_toTopOf="@id/tabTextTools"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toolbarTextEditor">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/flTextCanvas">

                    <EditText
                        android:id="@+id/etTextPost"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autofillHints="Bonga ikutoke"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:hint="@string/whats_on_your_mind"
                        android:inputType="textMultiLine"
                        android:padding="30dp"
                        android:textColor="@android:color/white"
                        android:textSize="36sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Media selection and camera preview step -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Camera preview -->
            <club.gifters.giftersclub.gifts.SafePreviewView
                android:id="@+id/previewView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingClass" />

            <TextView
                android:id="@+id/tvElapsedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Top right controls: switch camera, flash, timer, filters -->
            <LinearLayout
                android:id="@+id/topControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/switch_camera"
                    android:src="@drawable/switch_camera" />

                <ImageView
                    android:id="@+id/btnToggleFlash"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/toggle_flash"
                    android:src="@drawable/toggle_light" />

                <ImageView
                    android:id="@+id/btnSetTimer"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/set_recording_timer"
                    android:src="@drawable/timer" />

                <ImageView
                    android:id="@+id/btnShowFilters"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/show_filters"
                    android:src="@drawable/filters" />
            </LinearLayout>


            <!-- Bottom filter and device picker row -->
            <!-- Camera filter list and record spinner -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottomControlsBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">


                <!-- Circular zoom control -->
                <com.akaita.android.circularseekbar.CircularSeekBar
                    android:id="@+id/zoomControl"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@id/captureButtonAndProgressBar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Zoom preset levels -->
                <LinearLayout
                    android:id="@+id/zoomLevels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@id/zoomControl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/zoom05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="0.5x"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/zoom1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="1x"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/zoom2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="2x"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/zoom4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="4x"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/zoom8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="8x"
                        android:textColor="@android:color/white" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="4dp"
                        android:background="@color/white" />

                    <!-- Bottom controls: timers, mode switches -->
                    <LinearLayout
                        android:id="@+id/bottomControlsTop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTimer10m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/_10m"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/btnTimer60s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/_60s"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/btnTimer15s"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/_15s"
                            android:textColor="@color/white" />


                    </LinearLayout>


                </LinearLayout>

                <!-- Camera filter list and record spinner -->
                <HorizontalScrollView
                    android:id="@+id/hsvFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/captureButtonAndProgressBar"
                    app:layout_constraintEnd_toStartOf="@id/captureButtonAndProgressBar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/captureButtonAndProgressBar">

                    <LinearLayout
                        android:id="@+id/layoutFilterOptions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <FrameLayout
                    android:id="@+id/captureButtonAndProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/btnCapture"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/capture"
                        android:src="@drawable/record" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/pbRecordProgress"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:visibility="gone"
                        app:indicatorColor="@color/pink_500"
                        app:indicatorDirectionCircular="clockwise"
                        app:indicatorSize="60dp"
                        app:trackThickness="4dp" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnModeToggle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/toggle_photo_video"
                    android:src="@drawable/video"
                    app:layout_constraintBottom_toBottomOf="@id/captureButtonAndProgressBar"
                    app:layout_constraintEnd_toStartOf="@id/btnTextMode"
                    app:layout_constraintTop_toTopOf="@id/captureButtonAndProgressBar" />

                <ImageView
                    android:id="@+id/btnTextMode"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/create_text_post"
                    android:src="@drawable/text"
                    app:layout_constraintBottom_toBottomOf="@id/captureButtonAndProgressBar"
                    app:layout_constraintEnd_toStartOf="@id/btnSelectDevice"
                    app:layout_constraintTop_toTopOf="@id/captureButtonAndProgressBar" />

                <ImageView
                    android:id="@+id/btnSelectDevice"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/select_from_device"
                    android:src="@drawable/images"
                    app:layout_constraintBottom_toBottomOf="@id/captureButtonAndProgressBar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/captureButtonAndProgressBar" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Edit media step -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutEdit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:orientation="vertical"
            android:visibility="gone">


            <club.gifters.giftersclub.gifts.SafeGPUImageView
                android:id="@+id/imageEditView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@id/layoutEdit"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit"
                app:layout_constraintStart_toStartOf="@id/layoutEdit"
                app:layout_constraintTop_toTopOf="@id/layoutEdit" />

            <!-- Filter picker -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layout_constraintBottom_toTopOf="@id/btnApplyFilterCard"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit" />

            <SeekBar
                android:id="@+id/sbFilterLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                app:layout_constraintBottom_toTopOf="@id/btnApplyFilterCard"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit" />

            <androidx.cardview.widget.CardView
                android:id="@+id/btnApplyFilterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="@id/layoutEdit"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit"
                app:layout_constraintStart_toStartOf="@id/layoutEdit">

                <Button
                    android:id="@+id/btnApplyFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyan_sky_gradient"
                    android:text="@string/apply_filter"
                    android:textColor="@color/white" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Details step -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone">

            <!-- Crop & Scale controls -->
            <LinearLayout
                android:id="@+id/layoutCropScaleToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnCrop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/crop"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_crop" />

                <ImageView
                    android:id="@+id/btnScale"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/scale"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_zoom" />

            </LinearLayout>

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top"
                android:hint="@string/whats_on_your_mind"
                android:inputType="textMultiLine"
                android:padding="8dp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/layoutDetailsPostButtons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layoutDetailsPostButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/layoutDetailsDivider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="7dp">

                    <Button
                        android:id="@+id/btnEditMedia"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_rose_amber_gradient"
                        android:text="@string/edit_media"
                        android:textColor="@color/white" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:cardCornerRadius="7dp">

                    <Button
                        android:id="@+id/btnPost"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_green_emerald_gradient"
                        android:text="@string/post"
                        android:textColor="@color/white" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <View
                android:id="@+id/layoutDetailsDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutDetailsDivider">

                <RadioGroup
                    android:id="@+id/rgAccessType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbFree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/free"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rbSubscriberOnly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/subscriber_only"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rbPaid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/paid"
                        android:textColor="@color/white" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/price_tokens"
                    android:inputType="number"
                    android:textColor="@color/white"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>

    <!--TODO: Add is_story_time, is_tea and other customized post type to make it more social more vibrant-->