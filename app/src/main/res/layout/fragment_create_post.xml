<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/createPostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/flStepContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Text post editor screen (hidden by default) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutTextEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Toolbar with Cancel and Done -->
            <LinearLayout
                android:id="@+id/toolbarTextEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/btnCancelTextPost"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="❌" />

                <TextView
                    android:id="@+id/tvTextEditorTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/whats_on_your_mind"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnDoneTextPost"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="✔️" />
            </LinearLayout>

            <!-- Editable canvas (rendered to bitmap) -->
            <FrameLayout
                android:id="@+id/flTextCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <EditText
                    android:id="@+id/etTextPost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:hint="@string/whats_on_your_mind"
                    android:inputType="textMultiLine"
                    android:padding="30dp"
                    android:textColor="@android:color/white"
                    android:textSize="36sp" />
            </FrameLayout>

            <!-- Tabs for text styling tools -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabTextTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toTopOf="@id/llTextControlsContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tabGravity="fill"
                app:tabMode="fixed"
                app:tabTextColor="@color/white" />

            <!-- Styling controls (only one group visible at a time) -->
            <LinearLayout
                android:id="@+id/llTextControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <HorizontalScrollView
                    android:id="@+id/hsvTextStyles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llTextStyles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvColorPickers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llColorPickers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvBgImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llBgImages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/hsvFonts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llFonts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Media selection and camera preview step -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Camera preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingClass" />

            <TextView
                android:id="@+id/tvElapsedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Top right controls: switch camera, flash, timer, filters -->
            <LinearLayout
                android:id="@+id/topControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnSwitchCamera"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/switch_camera"
                    android:src="@drawable/switch_camera" />

                <ImageView
                    android:id="@+id/btnToggleFlash"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/toggle_flash"
                    android:src="@drawable/toggle_light" />

                <ImageView
                    android:id="@+id/btnSetTimer"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/set_recording_timer"
                    android:src="@drawable/timer" />

                <ImageView
                    android:id="@+id/btnShowFilters"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginVertical="5dp"
                    android:contentDescription="@string/show_filters"
                    android:src="@drawable/filters" />
            </LinearLayout>

            <!-- Bottom controls: timers, mode switches -->
            <LinearLayout
                android:id="@+id/bottomControlsTop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                app:layout_constraintBottom_toTopOf="@id/bottomControlsBottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/btnTimer10m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:text="10m" />

                <TextView
                    android:id="@+id/btnTimer60s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:text="60s" />

                <TextView
                    android:id="@+id/btnTimer15s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:text="15s" />

                <ImageView
                    android:id="@+id/btnModeToggle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/toggle_photo_video"
                    android:src="@drawable/camera" />

                <ImageView
                    android:id="@+id/btnTextMode"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="Create text post"
                    android:src="@drawable/text" />
            </LinearLayout>

            <!-- Bottom filter and device picker row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottomControlsBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">


                <!-- Camera filter list and record spinner -->
                <HorizontalScrollView
                    android:id="@+id/hsvFilters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/captureButtonAndProgressBar">

                    <LinearLayout
                        android:id="@+id/layoutFilterOptions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <FrameLayout
                    android:id="@+id/captureButtonAndProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnSelectDevice"
                    app:layout_constraintStart_toEndOf="@id/hsvFilters"
                    app:layout_constraintTop_toTopOf="parent">

                    <ProgressBar
                        android:id="@+id/pbRecordProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:rotation="270"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/btnCapture"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/capture"
                        android:src="@drawable/record" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnSelectDevice"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/select_from_device"
                    android:src="@drawable/images"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Edit media step -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutEdit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:orientation="vertical"
            android:visibility="gone">

            <jp.co.cyberagent.android.gpuimage.GPUImageView
                android:id="@+id/imageEditView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@id/layoutEdit"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit"
                app:layout_constraintStart_toStartOf="@id/layoutEdit"
                app:layout_constraintTop_toTopOf="@id/layoutEdit" />

            <!-- Filter picker -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layout_constraintBottom_toTopOf="@id/btnApplyFilter"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit" />

            <SeekBar
                android:id="@+id/sbFilterLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50"
                app:layout_constraintBottom_toTopOf="@id/btnApplyFilter"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit" />

            <Button
                android:id="@+id/btnApplyFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/apply_filter"
                app:layout_constraintBottom_toBottomOf="@id/layoutEdit"
                app:layout_constraintEnd_toEndOf="@id/layoutEdit"
                app:layout_constraintStart_toStartOf="@id/layoutEdit" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Details step -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:visibility="gone"
            android:background="@color/black">

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top"
                android:hint="@string/whats_on_your_mind"
                android:inputType="textMultiLine"
                android:padding="8dp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@id/layoutDetailsPostButtons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layoutDetailsPostButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@id/layoutDetailsDivider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <Button
                    android:id="@+id/btnEditMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_media" />

                <Button
                    android:id="@+id/btnPost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/post" />

            </LinearLayout>

            <View
                android:id="@+id/layoutDetailsDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutDetailsDivider">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="@string/who_can_view_this_post"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switchWhoCanSeePost"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWhoCanSeePost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="Allow comments"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/switchAllowComments"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAllowComments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>