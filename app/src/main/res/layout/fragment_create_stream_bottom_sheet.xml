<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_top"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStreamSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/start_live_stream"
        android:textSize="20sp"
        android:textStyle="bold" />


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp">

        <EditText
            android:id="@+id/etStreamTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_half_transparent_white"
            android:hint="@string/stream_title"
            android:inputType="textCapSentences"
            android:padding="10dp" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/bg_half_transparent_white">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category (required)"
                android:textStyle="bold"
                android:textColor="@android:color/black" />
            <AutoCompleteTextView
                android:id="@+id/actvCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search categories…"
                android:inputType="text"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp">
        <EditText
            android:id="@+id/etStreamTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_half_transparent_white"
            android:hint="Tags (optional, comma-separated)"
            android:inputType="text"
            android:padding="10dp" />
    </androidx.cardview.widget.CardView>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/bg_half_transparent_white">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live access"
                android:textStyle="bold"
                android:textColor="@android:color/black" />
            <RadioGroup
                android:id="@+id/rgLiveAccessType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">
                <RadioButton
                    android:id="@+id/rbLiveFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/free" />
                <RadioButton
                    android:id="@+id/rbLiveSubscriberOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/subscriber_only" />
                <RadioButton
                    android:id="@+id/rbLivePaid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/paid" />
            </RadioGroup>

            <EditText
                android:id="@+id/etLivePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/price_tokens"
                android:inputType="number"
                android:visibility="gone"
                android:paddingVertical="8dp" />

            <LinearLayout
                android:id="@+id/layoutPlanPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select required plan"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />
                <AutoCompleteTextView
                    android:id="@+id/actvPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Choose a plan"
                    android:paddingVertical="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutNoPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="8dp">
                <TextView
                    android:id="@+id/tvNoPlansMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You haven't created any subscription plans yet. Create at least one to use Subscriber Only."
                    android:textColor="@android:color/black" />
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="8dp">
                    <Button
                        android:id="@+id/btnOpenSubscriptionSettingsFromLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create a Subscription Plan" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="10dp">

        <EditText
            android:id="@+id/etStreamDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_half_transparent_white"
            android:gravity="top|start"
            android:hint="@string/stream_description_optional"
            android:inputType="textCapSentences"
            android:padding="10dp" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp">

            <Button
                android:id="@+id/btnCancelLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_red_orange_gradient"
                android:textColor="@color/white"
                android:text="@android:string/cancel" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:cardCornerRadius="10dp">
        <Button
            android:id="@+id/btnScheduleLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule"
            android:background="@drawable/bg_neutral_slate_gradient"
            android:textColor="@color/white" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:cardCornerRadius="10dp">
        <Button
            android:id="@+id/btnStartLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sky_blue_gradient"
            android:textColor="@color/white"
            android:text="@string/start" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</LinearLayout>
