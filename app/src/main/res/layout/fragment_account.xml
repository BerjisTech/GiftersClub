<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <!-- Profile Image with edit button -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Profile Image"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

            <TextView
                android:id="@+id/btnEditImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:text="🖍" />
        </FrameLayout>

        <!-- Username section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Username"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="username" />

            <TextView
                android:id="@+id/btnEditUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖍" />
        </LinearLayout>

        <!-- Full name section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Full Name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="Full Name" />

            <TextView
                android:id="@+id/btnEditFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖍️" />
        </LinearLayout>

        <!-- Stats section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#CCCCCC" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tokens"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTokenBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance: 0" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="#CCCCCC" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tokensBalanceNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTokensReceived"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAlignment="textEnd"
                        android:text="Received: 0"
                        android:layout_marginHorizontal="9dp"
                        app:layout_constraintTop_toTopOf="@id/tokensBalanceNumbers"
                        app:layout_constraintBottom_toBottomOf="@id/tokensBalanceNumbers"
                        app:layout_constraintStart_toStartOf="@id/tokensBalanceNumbers"
                        app:layout_constraintEnd_toStartOf="@id/tokensNumbersDivider"/>

                    <View
                        android:id="@+id/tokensNumbersDivider"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="9dp"
                        android:background="#CCCCCC"
                        app:layout_constraintTop_toTopOf="@id/tokensBalanceNumbers"
                        app:layout_constraintBottom_toBottomOf="@id/tokensBalanceNumbers"
                        app:layout_constraintStart_toStartOf="@id/tokensBalanceNumbers"
                        app:layout_constraintEnd_toEndOf="@id/tokensBalanceNumbers"/>

                    <TextView
                        android:id="@+id/tvTokensSent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Sent: 0"
                        android:layout_marginHorizontal="9dp"
                        app:layout_constraintTop_toTopOf="@id/tokensBalanceNumbers"
                        app:layout_constraintBottom_toBottomOf="@id/tokensBalanceNumbers"
                        app:layout_constraintStart_toEndOf="@id/tokensNumbersDivider"
                        app:layout_constraintEnd_toEndOf="@id/tokensBalanceNumbers"/>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/tokenButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnBuyTokens"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="7dp"
                        android:text="@string/buy_tokens"
                        app:layout_constraintBottom_toBottomOf="@id/tokenButtons"
                        app:layout_constraintEnd_toStartOf="@id/tokenButtonsDivider"
                        app:layout_constraintStart_toStartOf="@id/tokenButtons"
                        app:layout_constraintTop_toTopOf="@id/tokenButtons" />


                    <View
                        android:id="@+id/tokenButtonsDivider"
                        android:layout_width="1dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="9dp"
                        android:background="#CCCCCC"
                        app:layout_constraintBottom_toBottomOf="@id/tokenButtons"
                        app:layout_constraintEnd_toEndOf="@id/tokenButtons"
                        app:layout_constraintStart_toStartOf="@id/tokenButtons"
                        app:layout_constraintTop_toTopOf="@id/tokenButtons" />
                    <!-- Withdrawal link -->
                    <Button
                        android:id="@+id/btnWithdrawals"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="7dp"
                        android:text="Withdrawals"
                        app:layout_constraintBottom_toBottomOf="@id/tokenButtons"
                        app:layout_constraintEnd_toEndOf="@id/tokenButtons"
                        app:layout_constraintStart_toEndOf="@id/tokenButtonsDivider"
                        app:layout_constraintTop_toTopOf="@id/tokenButtons" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/giftsAndWishlistsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/giftsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/giftsAndWishlistsCard"
                app:layout_constraintEnd_toStartOf="@id/giftsAndWishlistsCardDivider"
                app:layout_constraintStart_toStartOf="@id/giftsAndWishlistsCard"
                app:layout_constraintTop_toTopOf="@id/giftsAndWishlistsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gifts"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGiftsReceived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Received: 0" />

                    <TextView
                        android:id="@+id/tvGiftsSent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sent: 0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <View
                android:id="@+id/giftsAndWishlistsCardDivider"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="9dp"
                android:background="#CCCCCC"
                app:layout_constraintBottom_toBottomOf="@id/giftsAndWishlistsCard"
                app:layout_constraintEnd_toEndOf="@id/giftsAndWishlistsCard"
                app:layout_constraintStart_toStartOf="@id/giftsAndWishlistsCard"
                app:layout_constraintTop_toTopOf="@id/giftsAndWishlistsCard" />
            <!-- Withdrawal link -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wishlistsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="7dp"
                app:layout_constraintBottom_toBottomOf="@id/giftsAndWishlistsCard"
                app:layout_constraintEnd_toEndOf="@id/giftsAndWishlistsCard"
                app:layout_constraintStart_toEndOf="@id/giftsAndWishlistsCardDivider"
                app:layout_constraintTop_toTopOf="@id/giftsAndWishlistsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="9dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wishlists"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWishlistsOpen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open: 0" />

                    <TextView
                        android:id="@+id/tvWishlistsFulfilled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fulfilled: 0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Gifts and wishlists -->


        <!-- Share profile -->
        <Button
            android:id="@+id/btnShareProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Share Profile" />

    </LinearLayout>
</ScrollView>